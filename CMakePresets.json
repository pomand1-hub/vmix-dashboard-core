{
  "version": 8,
  "cmakeMinimumRequired": {"major": 3, "minor": 28, "patch": 0},
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.22621",
      "warnings": {"dev": true, "deprecated": true}
    },
    {"name": "windows-ci-x64", "inherits": ["windows-x64"], "displayName": "Windows x64 CI"}
  ],
  "buildPresets": [
    {"name": "windows-x64", "configurePreset": "windows-x64", "configuration": "RelWithDebInfo"},
    {"name": "windows-ci-x64", "configurePreset": "windows-ci-x64", "configuration": "RelWithDebInfo"}
  ]
}
